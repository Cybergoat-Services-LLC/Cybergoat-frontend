# =======================================================
# CyberGOAT Next.js Frontend Environment Variables Spec
# GitHub Organization: Cybergoat services
# Repository: cybergoat-frontend
# =======================================================

# Server-Side Private Environment Variables (Vercel / Hosting)
# Google Vertex AI configuration for AI Course Advisor (/api/chat)
GOOGLE_VERTEX_PROJECT=your_gcp_project_id_here
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-3.8-flash
GOOGLE_VERTEX_CREDENTIALS={"type":"service_account"}

# Legacy Gemini API Key fallback (if Vertex AI is not used)
GEMINI_API_KEY=your_google_gemini_api_key_here

# NextAuth Authentication
NEXTAUTH_SECRET=generate_a_long_random_string_here
NEXTAUTH_URL=https://www.cybergoat.ae

# Required to manage the AI chatbot's knowledge base via /api/knowledge (admin only)
ADMIN_API_KEY=generate_a_long_random_string_here

# Public Client-Side Environment Variables (Exposed to Browser)
NEXT_PUBLIC_SITE_URL=https://www.cybergoat.ae
NEXT_PUBLIC_LMS_URL=https://lms.cybergoat.ae
NEXT_PUBLIC_WHATSAPP_NUMBER=971551846786
NEXT_PUBLIC_API_BASE_URL=https://backend.cybergoat.ae/api
